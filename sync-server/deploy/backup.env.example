# /etc/hitop-sync/backup.env (root only, 0600): read by hitop-sync-backup.service and by
# backup.sh / restore-drill.sh run by hand. The owner provides the bucket, its key and the age key
# (spec/CLOUD_SERVICE.md section 11, C0); nothing here works before that.

# Where backups go: a bucket at ANOTHER provider or region than the VM (the VM can be lost).
BACKUP_TARGET=s3://hitop-backups/sync
S3_ENDPOINT=https://s3.example-provider.com
S3_REGION=eu-central-1
# A key that may PUT (and LIST) under the prefix, preferably without DELETE: a lifecycle rule on
# the bucket expires objects after 35 days, so a compromised VM can't erase its backups.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The owner's age public key(s), one per line (age1...); the private key stays offline.
AGE_RECIPIENTS_FILE=/etc/hitop-sync/backup-recipients.txt

# Delete backups older than this many days from here (0 = leave it to the bucket's lifecycle
# rule; needs a key with delete rights otherwise).
BACKUP_KEEP_DAYS=0

# Only when the database is Postgres and pg_dump isn't on PATH:
# HITOP_SYNC_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only, fixed brand colours (no wallpaper colour): the window behind Compose. -->
    <style name="Theme.Hitop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <color name="ground">#0B0B0E</color>
</resources>

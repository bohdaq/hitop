{
  "name": "hitop-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "dev:tauri": "npm run wasm && vite --mode tauri --port 1421 --strictPort",
    "build": "npm run wasm && VITE_HITOP_PROXY=/api/proxy vite build",
    "build:tauri": "npm run wasm && vite build --mode tauri --outDir dist-tauri --base ./",
    "preview": "vite preview",
    "test:unit": "npm run wasm && node tests/unit.mjs && node tests/unit-ux.mjs && node tests/pm.mjs",
    "test:e2e": "node tests/e2e.cjs && node tests/editing.cjs && node tests/features.cjs && node tests/extras.cjs && node tests/folders.cjs && node tests/postman.cjs && node tests/settings.cjs && node tests/globals.cjs && node tests/graphql.cjs && node tests/diff-code.cjs && node tests/websocket.cjs && node tests/grpc.cjs && node tests/openapi.cjs && node tests/git.cjs && node tests/secret-refs.cjs && node tests/ux.cjs && node tests/ux12.cjs && node tests/onboarding.cjs && node tests/sse.cjs && node tests/ai.cjs && node tests/sync.cjs && node tests/library.cjs && node tests/github.cjs && node tests/next.cjs && node tests/collections-ux.cjs",
    "test:e2e:tauri": "HITOP_MODE=tauri npm run test:e2e",
    "visual": "node tests/visual.cjs",
    "build:extension": "node scripts/build-wasm.mjs --scripts && vite build --mode extension",
    "lint": "eslint ."
  },

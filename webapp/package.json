{
  "name": "hitop-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "dev:tauri": "npm run wasm && VITE_HITOP_PLATFORM=tauri vite --port 1421 --strictPort",
    "build": "npm run wasm && VITE_HITOP_PROXY=/api/proxy vite build",
    "build:tauri": "npm run wasm && VITE_HITOP_PLATFORM=tauri vite build --outDir dist-tauri --base ./",
    "preview": "vite preview",
    "test:unit": "npm run wasm && node tests/unit.mjs && node tests/pm.mjs",
    "test:e2e": "node tests/e2e.cjs && node tests/editing.cjs && node tests/features.cjs && node tests/extras.cjs && node tests/folders.cjs && node tests/postman.cjs && node tests/settings.cjs && node tests/globals.cjs",
    "test:e2e:tauri": "HITOP_MODE=tauri npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lit-material/alert": "0.0.4",
    "@lit-material/button": "0.1.3",
    "@lit-material/checkbox": "0.0.3",
    "@lit-material/code-block": "0.1.1",
    "@lit-material/color-scheme": "0.1.1",
    "@lit-material/confirm": "0.1.3",
    "@lit-material/dialog": "0.0.4",
    "@lit-material/empty-state": "0.0.2",
    "@lit-material/icon": "0.1.0",
    "@lit-material/icon-button": "0.0.4",
    "@lit-material/key-value": "0.1.2",
    "@lit-material/list": "0.0.4",
    "@lit-material/menu": "0.0.3",
    "@lit-material/select": "0.0.4",
    "@lit-material/snackbar": "0.0.4",
    "@lit-material/sortable": "0.2.1",
    "@lit-material/status": "0.0.2",
    "@lit-material/switch": "0.0.3",
    "@lit-material/tabs": "0.1.1",
    "@lit-material/text-field": "0.3.0",
    "@lit-material/tokens": "0.0.2",
    "@phosphor-icons/core": "2.1.1",
    "fflate": "0.8.2",
    "highlight.js": "11.11.1",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.3.4"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  HITOP for the Microsoft Store: a Win32 (full trust) app in an MSIX package. This is a template:
  desktop/msstore/make-layout.mjs fills in the placeholders (XML-escaped) and writes the result
  into the package layout. Identity comes from the Partner Center name reservation (repository
  variables MSSTORE_IDENTITY_NAME, MSSTORE_PUBLISHER, MSSTORE_PUBLISHER_DISPLAY_NAME); without
  them the package is a self-signed test package. See launch/microsoft-store.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>{{DESCRIPTION}}</Description>
  </Properties>

  <!-- 2004 (19041) and later: WebView2 ships with Windows 11 and reaches Windows 10 through Windows
       Update; an MSIX package can't run the WebView2 installer itself. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />{{PACKAGE_DEPENDENCIES}}
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HITOP" Executable="hitop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{APP_DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="HITOP" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- runFullTrust: a desktop (Win32) app, as every Tauri app is. Full trust apps aren't network
       isolated, so internetClient is declarative (the Store listing shows it); localhost and LAN
       targets work without a loopback exemption. -->
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

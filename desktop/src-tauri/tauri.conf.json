{
  "productName": "HITOP",
  "version": "1.0.1",
  "identifier": "tech.rws8.hitop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HITOP",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Developer Tools",
    "copyright": "© 2025 Bohdan Tsap",
    "shortDescription": "The API client your terminal, your CI and your AI agent can all drive.",
    "longDescription": "HITOP: the API client your terminal, your CI and your AI agent can all drive. Send requests, keep collections as folders of YAML files in your repository, script them in JavaScript and run them in CI. No account, MIT licensed.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.mas.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "XD7JHZ5DB3",
      "signingIdentity": "3rd Party Mac Developer Application: Bogdan Tsap (XD7JHZ5DB3)"
    }
  }
}

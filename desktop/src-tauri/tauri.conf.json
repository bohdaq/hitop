    "copyright": "© 2025 Bohdan Tsap",
    "shortDescription": "HTTP API testing tool",
    "longDescription": "HITOP is a native HTTP API testing tool. Send requests, manage collections, use variables, and run pre/post request scripts — all stored locally.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.mas.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "XD7JHZ5DB3",
      "signingIdentity": "3rd Party Mac Developer Application: Bogdan Tsap (XD7JHZ5DB3)"
    }
